<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mileage Log Blog — Tax Tips, IRS Rules, Driver Guides | MileageLogMaker</title>
<meta name="description" content="Free guides on IRS mileage rules, tax deductions for drivers, and how to maximize your business mileage write-off in 2026.">
<link rel="canonical" href="https://mileagelogmaker.com/blog">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f7f9fc;color:#0a2540;line-height:1.6}
.nav{background:#fff;border-bottom:1px solid #e6ebf1;padding:14px 0}
.nav-inner{max-width:1200px;margin:0 auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:18px;font-weight:700;color:#0a2540;text-decoration:none}
.nav-links a{color:#425466;text-decoration:none;margin-left:20px;font-size:14px}

.hero{padding:60px 20px 30px;text-align:center;background:#fff;border-bottom:1px solid #e6ebf1}
.hero h1{font-size:42px;font-weight:800;margin-bottom:12px;letter-spacing:-0.5px}
.hero p{font-size:17px;color:#425466;max-width:600px;margin:0 auto}

.posts{max-width:900px;margin:50px auto;padding:0 20px;display:grid;gap:18px}
.post-card{background:#fff;border:1px solid #e6ebf1;border-radius:12px;padding:28px;text-decoration:none;color:#0a2540;transition:all .15s;display:block}
.post-card:hover{border-color:#635bff;box-shadow:0 4px 16px rgba(99,91,255,.1)}
.post-card .meta{font-size:12px;color:#8898aa;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px}
.post-card h2{font-size:22px;font-weight:700;margin-bottom:10px;line-height:1.3}
.post-card p{color:#425466;font-size:15px}

footer{background:#0a2540;color:#a3b1cc;padding:30px 20px;text-align:center;margin-top:60px;font-size:13px}
footer a{color:#fff;text-decoration:none;margin:0 10px}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="logo">📍 MileageLogMaker</a>
    <div class="nav-links">
      <a href="/">Tool</a>
      <a href="/free-mileage-log-template">Template</a>
    </div>
  </div>
</nav>

<section class="hero">
  <h1>Mileage Tax Blog</h1>
  <p>Free guides on IRS mileage rules, tax deductions for drivers, and maximizing your business write-offs.</p>
</section>

<div class="posts">
  <% posts.forEach(function(p){ %>
    <a href="/<%= p.slug %>" class="post-card">
      <div class="meta"><%= p.date %> • <%= p.read %> read</div>
      <h2><%= p.title %></h2>
      <p><%= p.description %></p>
    </a>
  <% }); %>
</div>

<footer>
  <div>
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
  </div>
  <div style="margin-top:16px">© 2026 MileageLogMaker</div>
</footer>

</body>
</html>

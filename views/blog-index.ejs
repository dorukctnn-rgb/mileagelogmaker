<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Mileage Tax Guides: IRS Rules, Rates and Deductions', description: 'Plain-English guides to IRS mileage rules, the 2026 rate change, standard mileage vs actual expenses and deductions for rideshare drivers.', canonical: canonical }) %>
<style>
.posts{max-width:900px;margin:30px auto 50px;padding:0 16px;display:grid;gap:14px}
.post-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:24px;text-decoration:none;color:var(--navy);display:block}
.post-card:hover{border-color:var(--accent)}
.post-card .meta{font-size:12px;color:#7a8aa0;margin-bottom:6px;text-transform:uppercase;letter-spacing:.5px}
.post-card h2{font-size:21px;font-weight:700;margin-bottom:8px;line-height:1.3}
.post-card p{color:#425466;font-size:15px}
</style>
</head>
<body>
<%- include('partials/nav') %>
<section class="hero">
  <h1>Mileage Tax Guides</h1>
  <p class="lead">Guides on IRS mileage rules, the 2026 rates and the deductions drivers most often miss.</p>
</section>
<div class="posts">
  <% posts.forEach(function(p){ %>
    <a href="/<%= p.slug %>" class="post-card">
      <div class="meta"><%= p.date %>, <%= p.read %> read</div>
      <h2><%= p.title %></h2>
      <p><%= p.description %></p>
    </a>
  <% }); %>
</div>
<%- include('partials/footer') %>
<%- include('partials/pro-modal') %>
<script>window.MLM_RATES = <%- CLIENT_RATES %>;</script>
<script src="/calc.js?v=3"></script>
<script src="/app.js?v=4"></script>
</body>
</html>

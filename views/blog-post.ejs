<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: post.title, description: post.description, canonical: canonical, ogType: 'article' }) %>
<script type="application/ld+json"><%- JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: post.title, description: post.description, mainEntityOfPage: canonical,
      datePublished: post.published || '2026-05-01', dateModified: post.updated || '2026-10-07',
      author: { '@type': 'Organization', name: 'MileageLogMaker', url: SITE + '/' },
      publisher: { '@type': 'Organization', name: 'MileageLogMaker', logo: { '@type': 'ImageObject', url: SITE + '/android-chrome-512x512.png' } },
      image: SITE + '/og-image.png' },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE + '/blog' },
      { '@type': 'ListItem', position: 3, name: post.title, item: canonical } ] }
  ]
}) %></script>
<style>
.post{max-width:760px;margin:40px auto 50px;padding:0 16px}
.post .meta{color:#7a8aa0;font-size:13px;margin-bottom:12px}
.post h1{font-size:36px;font-weight:800;line-height:1.2;margin-bottom:22px;letter-spacing:-.5px}
.post h2{font-size:24px;margin:34px 0 12px;font-weight:700}
.post p{font-size:17px;color:var(--ink);margin-bottom:16px}
.cta{background:var(--navy);color:#fff;padding:26px;border-radius:12px;margin:34px 0;text-align:center}
.cta h3{font-size:21px;margin-bottom:8px}
.cta p{color:rgba(255,255,255,.85)!important;margin-bottom:16px!important;font-size:15.5px!important}
.cta a{display:inline-block;background:#fff;color:var(--navy);padding:11px 22px;border-radius:7px;text-decoration:none;font-weight:600}
@media(max-width:600px){.post h1{font-size:28px}}
</style>
</head>
<body>
<%- include('partials/nav') %>
<article class="post">
  <div class="meta"><%= post.date %> · <%= post.read %> read</div>
  <h1><%= post.title %></h1>
  <% post.content.forEach(function(block, idx){ %>
    <% if(block.type === 'h2'){ %><h2><%= block.text %></h2><% } else { %><p><%= block.text %></p><% } %>
    <% if(idx === 3){ %>
      <div class="cta">
        <h3>Make your mileage log in a few minutes</h3>
        <p>Free, no signup. Enter trips and download a PDF with the 2026 IRS rates applied by date.</p>
        <a href="/#generator">Open the generator</a>
      </div>
    <% } %>
  <% }); %>
  <div class="sources" style="margin-top:30px">
    <h2>Sources</h2>
    <ul>
      <li><a href="<%= R.SOURCES.irsRates.url %>" target="_blank" rel="noopener"><%= R.SOURCES.irsRates.label %></a></li>
      <li><a href="<%= R.SOURCES.pub463.url %>" target="_blank" rel="noopener"><%= R.SOURCES.pub463.label %></a></li>
    </ul>
    <p class="checked">Rates last checked on <%= R.LAST_CHECKED_TEXT %>.</p>
  </div>
</article>
<section class="related">
  <h2>Keep reading</h2>
  <div class="related-grid">
    <% allPosts.forEach(function(p){ %><a href="/<%= p.slug %>" class="related-card"><strong><%= p.title %></strong></a><% }); %>
    <a href="/irs-mileage-log-requirements" class="related-card"><strong>IRS Mileage Log Requirements</strong><span>What a compliant log needs, with a sample</span></a>
  </div>
</section>
<%- include('partials/footer') %>
<%- include('partials/pro-modal') %>
<script>window.MLM_RATES = <%- CLIENT_RATES %>;</script>
<script src="/calc.js?v=2"></script>
<script src="/app.js?v=2"></script>
</body>
</html>

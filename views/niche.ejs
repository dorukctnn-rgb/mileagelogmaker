<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= page.title %></title>
<meta name="description" content="<%= page.description %>">
<meta property="og:title" content="<%= page.title %>">
<meta property="og:description" content="<%= page.description %>">
<meta name="google-site-verification" content="lTAZNAqExJcgGVTl7hfH3sdplbLhtLtfScgj18hkzO4" />
<link rel="canonical" href="https://mileagelogmaker.com/<%= slug %>">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Mileage Log Maker",
  "applicationCategory": "FinanceApplication",
  "offers": { "@type": "Offer", "price": "0" },
  "operatingSystem": "Any"
}
</script>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f7f9fc;color:#0a2540;line-height:1.6}
.nav{background:#fff;border-bottom:1px solid #e6ebf1;padding:14px 0}
.nav-inner{max-width:1200px;margin:0 auto;padding:0 20px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:18px;font-weight:700;color:#0a2540;text-decoration:none}
.nav-links a{color:#425466;text-decoration:none;margin-left:20px;font-size:14px}
.nav-links a:hover{color:#0a2540}

.hero{padding:50px 20px 30px;text-align:center}
.hero h1{font-size:36px;font-weight:800;margin-bottom:14px;letter-spacing:-0.5px;max-width:800px;margin-left:auto;margin-right:auto}
.hero .lead{font-size:17px;color:#425466;max-width:740px;margin:0 auto 20px}
.hero .badge{display:inline-block;background:#e0f7e9;color:#0d8043;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:600;margin-bottom:18px}

.tool{max-width:1200px;margin:30px auto;padding:0 20px;display:grid;grid-template-columns:1fr 1fr;gap:24px}
@media(max-width:900px){.tool{grid-template-columns:1fr}}

.panel{background:#fff;border:1px solid #e6ebf1;border-radius:12px;padding:24px}
.panel h2{font-size:18px;margin-bottom:16px;font-weight:700}
.field{margin-bottom:14px}
.field label{display:block;font-size:13px;color:#425466;margin-bottom:6px;font-weight:500}
.field input,.field select{width:100%;padding:10px 12px;border:1px solid #e6ebf1;border-radius:6px;font-size:14px;font-family:inherit}
.field input:focus,.field select:focus{outline:none;border-color:#635bff;box-shadow:0 0 0 3px rgba(99,91,255,.1)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}

.btn{background:#635bff;color:#fff;border:none;padding:11px 20px;border-radius:6px;font-size:14px;font-weight:600;cursor:pointer;font-family:inherit}
.btn:hover{background:#5048e5}
.btn:disabled{background:#a8a3ff;cursor:not-allowed}
.btn-danger{background:#fff;color:#d13438;border:1px solid #fadbdb;padding:6px 10px;font-size:12px;border-radius:4px;cursor:pointer}

.trip-list{margin-top:16px;max-height:400px;overflow-y:auto}
.trip-item{background:#f7f9fc;padding:12px;border-radius:6px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;font-size:13px}
.trip-item .info{flex:1}
.trip-item .info strong{display:block;color:#0a2540}
.trip-item .info span{color:#425466;font-size:12px}
.trip-item .miles{color:#635bff;font-weight:700;margin:0 12px}

.summary{background:#0a2540;color:#fff;padding:24px;border-radius:12px;margin-top:24px}
.summary h3{font-size:16px;margin-bottom:14px;font-weight:600;opacity:.8}
.summary-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:14px}
.summary-row:last-child{border:none;font-size:18px;font-weight:700;padding-top:14px;margin-top:6px;border-top:2px solid rgba(255,255,255,.2)}
.empty{text-align:center;color:#8898aa;padding:40px 20px;font-size:14px}

.content{max-width:760px;margin:60px auto;padding:0 20px}
.content h2{font-size:24px;margin:30px 0 14px;font-weight:700}
.content p{margin-bottom:14px;color:#425466;font-size:16px}
.tips{background:#fff;border:1px solid #e6ebf1;border-radius:10px;padding:24px;margin-top:24px}
.tips h3{font-size:18px;margin-bottom:14px;font-weight:700}
.tips ul{list-style:none}
.tips li{padding:10px 0;border-bottom:1px solid #f0f4f8;color:#425466;padding-left:28px;position:relative}
.tips li:last-child{border:none}
.tips li:before{content:"✓";position:absolute;left:0;top:10px;color:#0d8043;font-weight:700}

.related{max-width:1200px;margin:60px auto;padding:0 20px}
.related h2{font-size:24px;margin-bottom:20px;font-weight:700}
.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:700px){.related-grid{grid-template-columns:1fr}}
.related-card{background:#fff;border:1px solid #e6ebf1;padding:18px;border-radius:8px;text-decoration:none;color:#0a2540;transition:all .15s}
.related-card:hover{border-color:#635bff;box-shadow:0 4px 12px rgba(99,91,255,.1)}
.related-card strong{display:block;font-size:14px}

footer{background:#0a2540;color:#a3b1cc;padding:30px 20px;text-align:center;margin-top:60px;font-size:13px}
footer a{color:#fff;text-decoration:none;margin:0 10px}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="logo">📍 MileageLogMaker</a>
    <div class="nav-links">
      <a href="/blog">Blog</a>
      <a href="/free-mileage-log-template">Template</a>
      <a href="/irs-mileage-log-requirements">IRS Rules</a>
      <a href="/mileage-log-2026-irs-rate">2026 Rates</a>
    </div>
  </div>
</nav>

<section class="hero">
  <span class="badge">2026 IRS Rate: 72.5¢/mile</span>
  <h1><%= page.h1 %></h1>
  <p class="lead"><%= page.intro %></p>
</section>

<div class="tool">
  <div class="panel">
    <h2>Add Trip</h2>
    <div class="field"><label>Date</label><input type="date" id="tripDate"></div>
    <div class="row2">
      <div class="field"><label>Start</label><input type="text" id="tripStart" placeholder="Home"></div>
      <div class="field"><label>End</label><input type="text" id="tripEnd" placeholder="Destination"></div>
    </div>
    <div class="field"><label>Purpose</label><input type="text" id="tripPurpose" placeholder="<%= page.keyword %>"></div>
    <div class="row2">
      <div class="field"><label>Miles</label><input type="number" id="tripMiles" step="0.1"></div>
      <div class="field"><label>Type</label>
        <select id="tripType">
          <option value="business">Business</option>
          <option value="medical">Medical</option>
          <option value="charity">Charity</option>
          <option value="personal">Personal</option>
        </select>
      </div>
    </div>
    <button class="btn" onclick="addTrip()">+ Add Trip</button>
    <div class="field" style="margin-top:24px">
      <label>Tax Year</label>
      <select id="taxYear">
        <option value="2026">2026 (72.5¢/mi)</option>
        <option value="2025">2025 (70¢/mi)</option>
        <option value="2024">2024 (67¢/mi)</option>
      </select>
    </div>
  </div>

  <div>
    <div class="panel">
      <h2>Trips (<span id="tripCount">0</span>)</h2>
      <div class="trip-list" id="tripList">
        <div class="empty">Add your first trip on the left.</div>
      </div>
      <button class="btn" id="generateBtn" onclick="generatePDF()" style="margin-top:16px;width:100%" disabled>Generate IRS-Ready PDF</button>
    </div>
    <div class="summary">
      <h3>Tax Deduction Summary</h3>
      <div class="summary-row"><span>Business</span><span id="sumBusiness">0.0 mi</span></div>
      <div class="summary-row"><span>Medical</span><span id="sumMedical">0.0 mi</span></div>
      <div class="summary-row"><span>Charity</span><span id="sumCharity">0.0 mi</span></div>
      <div class="summary-row"><span>Total Deduction</span><span id="sumTotal">$0.00</span></div>
    </div>
  </div>
</div>

<article class="content">
  <h2>What you need to know</h2>
  <p><%= page.intro %></p>

  <div class="tips">
    <h3>Quick tips for <%= page.h1.toLowerCase() %></h3>
    <ul>
      <% page.tips.forEach(function(tip){ %>
        <li><%= tip %></li>
      <% }); %>
    </ul>
  </div>

  <h2>How this generator helps</h2>
  <p>Most mileage trackers force you to download an app, create an account, or pay a subscription. This generator does none of that. Enter your trips above, click "Generate IRS-Ready PDF," and download a properly formatted log in seconds. Your data stays in your browser between sessions, so you can come back and add more trips throughout the year.</p>

  <h2>What goes in the PDF</h2>
  <p>The generated PDF includes everything the IRS requires: date, start location, end location, purpose, miles driven, and trip type. It also includes your odometer readings (if entered), a calculated tax deduction summary, and a clean header showing your name and vehicle. Print it, email it to your CPA, or upload it to TurboTax — it is ready for tax filing as-is.</p>
</article>

<section class="related">
  <h2>Related guides</h2>
  <div class="related-grid">
    <% allPages.forEach(function(p){ %>
      <a href="/<%= p.slug %>" class="related-card"><strong><%= p.h1 %></strong></a>
    <% }); %>
  </div>
</section>

<footer>
  <div>
    <a href="/">Home</a>
    <a href="/blog">Blog</a>
    <a href="/irs-mileage-log-requirements">IRS Rules</a>
    <a href="/forgot-to-track-mileage">Forgot to Track?</a>
  </div>
  <div style="margin-top:16px">© 2026 MileageLogMaker — Free IRS-compliant mileage tracking</div>
</footer>

<script>
const RATES_2026 = { business: <%= rates.business %>, medical: <%= rates.medical %>, charity: <%= rates.charity %>, personal: 0 };
const RATES_2025 = { business: 0.70, medical: 0.21, charity: 0.14, personal: 0 };
const RATES_2024 = { business: 0.67, medical: 0.21, charity: 0.14, personal: 0 };

let trips = JSON.parse(localStorage.getItem('mileage_trips') || '[]');

function save(){ localStorage.setItem('mileage_trips', JSON.stringify(trips)); }

function addTrip(){
  const t = {
    date: document.getElementById('tripDate').value,
    start: document.getElementById('tripStart').value,
    end: document.getElementById('tripEnd').value,
    purpose: document.getElementById('tripPurpose').value,
    miles: parseFloat(document.getElementById('tripMiles').value) || 0,
    type: document.getElementById('tripType').value
  };
  if(!t.date || !t.miles){ alert('Please enter at least a date and miles.'); return; }
  trips.push(t); save(); render();
  document.getElementById('tripStart').value = '';
  document.getElementById('tripEnd').value = '';
  document.getElementById('tripPurpose').value = '';
  document.getElementById('tripMiles').value = '';
}
function removeTrip(i){ trips.splice(i,1); save(); render(); }

function render(){
  const list = document.getElementById('tripList');
  document.getElementById('tripCount').textContent = trips.length;
  document.getElementById('generateBtn').disabled = trips.length === 0;

  if(trips.length === 0){
    list.innerHTML = '<div class="empty">Add your first trip on the left.</div>';
  } else {
    list.innerHTML = trips.map((t,i) => `
      <div class="trip-item">
        <div class="info">
          <strong>${t.date}: ${t.start || '?'} → ${t.end || '?'}</strong>
          <span>${t.purpose || 'No purpose'} • ${t.type}</span>
        </div>
        <div class="miles">${t.miles} mi</div>
        <button class="btn-danger" onclick="removeTrip(${i})">×</button>
      </div>
    `).join('');
  }

  const year = document.getElementById('taxYear').value;
  const rates = year === '2024' ? RATES_2024 : (year === '2025' ? RATES_2025 : RATES_2026);
  const totals = { business: 0, medical: 0, charity: 0, personal: 0 };
  trips.forEach(t => { if(totals[t.type] !== undefined) totals[t.type] += t.miles; });

  document.getElementById('sumBusiness').textContent = `${totals.business.toFixed(1)} mi ($${(totals.business * rates.business).toFixed(2)})`;
  document.getElementById('sumMedical').textContent = `${totals.medical.toFixed(1)} mi ($${(totals.medical * rates.medical).toFixed(2)})`;
  document.getElementById('sumCharity').textContent = `${totals.charity.toFixed(1)} mi ($${(totals.charity * rates.charity).toFixed(2)})`;
  const total = totals.business * rates.business + totals.medical * rates.medical + totals.charity * rates.charity;
  document.getElementById('sumTotal').textContent = `$${total.toFixed(2)}`;
}

document.getElementById('taxYear').addEventListener('change', render);

async function generatePDF(){
  const year = document.getElementById('taxYear').value;
  const btn = document.getElementById('generateBtn');
  btn.disabled = true; btn.textContent = 'Generating...';
  try{
    const res = await fetch('/generate-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ trips, userInfo: {}, year })
    });
    if(!res.ok) throw new Error('PDF failed');
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `mileage-log-${year}.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  } catch(e){ alert('Could not generate PDF. Try again.'); }
  btn.disabled = false; btn.textContent = 'Generate IRS-Ready PDF';
}

document.getElementById('tripDate').valueAsDate = new Date();
render();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: page.title, description: page.description, canonical: canonical }) %>
<%
  var crumbs = [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: page.h1, item: canonical }];
  var graph = [
    { '@type': 'WebPage', '@id': canonical + '#page', url: canonical, name: page.title, description: page.description, inLanguage: 'en',
      dateModified: page.updated || '2026-10-07', isPartOf: { '@type': 'WebSite', name: 'MileageLogMaker', url: SITE + '/' } },
    { '@type': 'BreadcrumbList', itemListElement: crumbs },
    { '@type': 'WebApplication', name: 'MileageLogMaker', url: SITE + '/', applicationCategory: 'FinanceApplication', operatingSystem: 'Any (web browser)',
      offers: [{ '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' }, { '@type': 'Offer', name: 'Pro (one-time)', price: '9', priceCurrency: 'USD', url: GUMROAD_URL }] }
  ];
  if (page.faq && page.faq.length) {
    graph.push({ '@type': 'FAQPage', mainEntity: page.faq.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]*>/g, '') } }; }) });
  }
  var srcKeys = page.sources || (region === 'ca' ? ['craRecords', 'craSelfEmployed', 'craAllowance'] : region === 'uk' ? ['hmrcRates', 'hmrcSimplified'] : ['irsRates', 'pub463']);
  var badge = page.badge || (region === 'ca' ? 'CRA 2026 allowance rates: 73¢ / 67¢ per km' : region === 'uk' ? 'HMRC: 55p a mile from 6 April 2026, then 25p' : '2026 IRS rate: 76¢ a mile from July 1 (72.5¢ before)');
  var articleFirst = page.layout === 'article';
%>
<script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }) %></script>
</head>
<body class="has-sticky">

<%- include('partials/nav') %>

<section class="hero">
  <span class="badge"><%= badge %></span>
  <h1><%= page.h1 %></h1>
  <p class="lead"><%- page.leadHtml || page.intro %></p>
  <div class="hero-ctas">
    <a href="#generator" class="btn"><%= page.ctaLabel || (region === 'ca' ? 'Fill in the logbook online' : 'Create your mileage log') %></a>
    <% if (page.templates && page.templates.length) { %><a href="#templates" class="btn btn-ghost">Download the template</a><% } %>
  </div>
</section>

<% function renderSections(list) { list.forEach(function (sec) { %>
  <h2<% if (sec.id) { %> id="<%= sec.id %>"<% } %>><%= sec.h %></h2>
  <% (sec.p || []).forEach(function (para) { %><p><%- para %></p><% }); %>
  <% if (sec.html) { %><%- sec.html %><% } %>
<% }); } %>

<% function renderSample() { if (!page.sample) return; %>
  <h2 id="sample"><%= page.sample.h || 'Sample mileage log' %></h2>
  <% if (page.sample.intro) { %><p><%- page.sample.intro %></p><% } %>
  <div class="table-wrap"><table class="data">
    <thead><tr><% page.sample.head.forEach(function (h, i) { %><th<% if ((page.sample.num || []).indexOf(i) >= 0) { %> class="num"<% } %>><%= h %></th><% }); %></tr></thead>
    <tbody><% page.sample.rows.forEach(function (r) { %><tr><% r.forEach(function (c, i) { %><td<% if ((page.sample.num || []).indexOf(i) >= 0) { %> class="num"<% } %>><%= c %></td><% }); %></tr><% }); %></tbody>
    <% if (page.sample.foot) { %><tfoot><tr><% page.sample.foot.forEach(function (c, i) { %><td<% if ((page.sample.num || []).indexOf(i) >= 0) { %> class="num"<% } %>><%= c %></td><% }); %></tr></tfoot><% } %>
    <% if (page.sample.caption) { %><caption><%= page.sample.caption %></caption><% } %>
  </table></div>
<% } %>

<% function renderTemplates() { if (!page.templates || !page.templates.length) return; %>
  <h2 id="templates"><%= page.templatesHeading || 'Download the free template' %></h2>
  <% if (page.templatesIntro) { %><p><%- page.templatesIntro %></p><% } %>
  <div class="downloads">
    <% page.templates.forEach(function (t) { %>
      <a class="dl" href="<%= t.href %>" download><strong><span class="fmt<%= t.fmt === 'PDF' ? ' pdf' : '' %>"><%= t.fmt %></span><%= t.title %></strong><span><%= t.sub %></span></a>
    <% }); %>
  </div>
<% } %>

<% if (page.calcFirst && page.calculator === 'delivery') { %>
<article class="content" style="margin-top:20px"><%- include('partials/calc-delivery') %></article>
<% } %>

<% if (articleFirst) { %>
<article class="content" style="margin-top:20px">
  <% if (page.answerHtml) { %><div class="answer"><%- page.answerHtml %></div><% } %>
  <% renderSections(page.sectionsBefore || []); %>
  <% renderSample(); %>
  <% renderTemplates(); %>
</article>
<% } %>

<%- include('partials/tool', { region: region, purposePlaceholder: page.purposePlaceholder }) %>

<article class="content">
  <% if (!articleFirst && page.answerHtml) { %><div class="answer"><%- page.answerHtml %></div><% } %>
  <% if (page.calculator === 'delivery' && !page.calcFirst) { %><%- include('partials/calc-delivery') %><% } %>
  <% if (page.calculator === 'cra-simplified') { %><%- include('partials/calc-cra') %><% } %>
  <% if (!articleFirst) { renderSample(); renderTemplates(); } %>
  <% if (page.tips && page.tips.length) { %>
  <div class="tips">
    <h3><%= page.tipsHeading || 'Quick checklist' %></h3>
    <ul><% page.tips.forEach(function (tip) { %><li><%- tip %></li><% }); %></ul>
  </div>
  <% } %>
  <% renderSections(page.sections || []); %>

  <div class="sources">
    <h2>Sources</h2>
    <ul>
      <% srcKeys.forEach(function (k) { var s = R.SOURCES[k]; if (s) { %><li><a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.label %></a></li><% } }); %>
    </ul>
    <p class="checked">Rates and rules on this page last checked against these sources on <%= R.LAST_CHECKED_TEXT %>.</p>
  </div>
</article>

<% if (page.faq && page.faq.length) { %>
<section class="faq-section">
  <h2>Frequently asked questions</h2>
  <% page.faq.forEach(function (item) { %>
    <details class="faq-item"><summary><%= item.q %></summary><div class="faq-a"><p><%- item.a %></p></div></details>
  <% }); %>
</section>
<% } %>

<section class="related">
  <h2>Related guides</h2>
  <div class="related-grid">
    <% related.forEach(function (p) { %>
      <a href="/<%= p.slug %>" class="related-card"><strong><%= p.h1 %></strong><% if (p.blurb) { %><span><%= p.blurb %></span><% } %></a>
    <% }); %>
  </div>
</section>

<div class="sticky-cta"><a href="#generator" class="btn">Create my log</a><% if (page.templates && page.templates.length) { %><a href="#templates" class="btn btn-ghost">Template</a><% } else { %><button type="button" class="btn btn-ghost" onclick="MLM.openPro()">Pro $9</button><% } %></div>

<%- include('partials/footer') %>
<%- include('partials/pro-modal') %>
<script>window.MLM_RATES = <%- CLIENT_RATES %>;</script>
<script src="/calc.js?v=2"></script>
<script src="/app.js?v=3"></script>
</body>
</html>

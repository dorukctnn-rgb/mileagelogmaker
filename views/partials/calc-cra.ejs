<h2 id="simplified-logbook">Simplified logbook calculator</h2>
<p>After one full base year, the CRA lets you keep a logbook for a representative three-month period and scale it with this formula: <strong>(sample period % &divide; base year same-period %) &times; base year annual % = annual business use</strong>.</p>
<div class="calc" id="ccalc">
  <div class="grid">
    <div class="field"><label for="ccBase">Base year: annual business use %</label><input type="number" id="ccBase" value="49" min="0" max="100" step="0.1" inputmode="decimal"></div>
    <div class="field"><label for="ccBaseSample">Base year: business use % for the same 3 months</label><input type="number" id="ccBaseSample" value="46" min="0" max="100" step="0.1" inputmode="decimal"></div>
    <div class="field"><label for="ccSample">This year: business use % in your 3-month sample</label><input type="number" id="ccSample" value="51" min="0" max="100" step="0.1" inputmode="decimal"></div>
  </div>
  <div class="calc-out" id="ccOut"></div>
</div>
<p style="font-size:14px;color:#56657a">The default numbers are the CRA's own example (49%, 46%, 51% gives 54%). The CRA says the base year stops being a fair indicator when the calculated annual business use goes up or down by more than 10%; the check below compares the two figures in percentage points, which is consistent with that example. If you are close to the line, keep a full logbook for the year.</p>
<script>
(function () {
  function g(id) { return document.getElementById(id); }
  function calc() {
    var base = parseFloat(g('ccBase').value) || 0, bs = parseFloat(g('ccBaseSample').value) || 0, s = parseFloat(g('ccSample').value) || 0;
    if (!bs) { g('ccOut').innerHTML = '<p>Enter the base year percentage for the same three months.</p>'; return; }
    var annual = Math.min(100, (s / bs) * base), diff = annual - base;
    var ok = Math.abs(diff) <= 10;
    g('ccOut').innerHTML = '<p>Calculated annual business use</p><p class="big">' + annual.toFixed(1) + '%</p>' +
      '<p>(' + s + '% &divide; ' + bs + '%) &times; ' + base + '% = ' + annual.toFixed(1) + '%, ' + (diff >= 0 ? 'up ' : 'down ') + Math.abs(diff).toFixed(1) + ' points from the base year.</p>' +
      '<p><strong>' + (ok ? 'Within 10 points of the base year: the simplified logbook can support this figure.' : 'More than 10 points from the base year: the sample only covers its own three months. Keep records for the rest of the year or start a new base year.') + '</strong></p>';
  }
  ['ccBase', 'ccBaseSample', 'ccSample'].forEach(function (id) { g(id).addEventListener('input', calc); });
  calc();
})();
</script>

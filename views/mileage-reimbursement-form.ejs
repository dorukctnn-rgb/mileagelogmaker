      <button type="button" class="btn btn-ghost btn-sm" id="clearTrips">Start a blank list</button>
      <span class="hint">Up to <%= Reimburse.MAX_TRIPS %> trips. A round trip can be one row.</span>
    </div>
    <ul class="rf-problems" id="rfProblems" hidden></ul>
  </form>

  <div class="rf-out">

    <h2>Claim details</h2>
    <p class="sub">Leave a box empty and the form prints a blank line there to fill in by hand.</p>
    <div class="grid2">
      <div class="field"><label for="rf_name">Employee or claimant</label><input type="text" id="rf_name" maxlength="80" autocomplete="name"></div>
      <div class="field"><label for="rf_staffId">Employee ID or department</label><input type="text" id="rf_staffId" maxlength="60"></div>
      <div class="field"><label for="rf_org">Employer or organization</label><input type="text" id="rf_org" maxlength="100" autocomplete="organization"></div>
      <div class="field"><label for="rf_approver">Approver</label><input type="text" id="rf_approver" maxlength="80"></div>
      <div class="field"><label for="rf_periodFrom">Claim period from</label><input type="date" id="rf_periodFrom"></div>
      <div class="field"><label for="rf_periodTo">Claim period to</label><input type="date" id="rf_periodTo"><small>Empty dates use the first and last trip.</small></div>
    </div>
    <div class="field"><label for="rf_vehicle">Vehicle</label><input type="text" id="rf_vehicle" maxlength="80" placeholder="Make, model and plate"></div>

    <h2 style="margin-top:18px">Trips</h2>
    <p class="sub">The three trips below are an example that crosses July 1. Replace them with yours.</p>
    <div class="seg" role="radiogroup" aria-label="Rate per mile">
      <label><input type="radio" name="rateMode" value="irs" checked><span>IRS standard rates</span></label>
      <label><input type="radio" name="rateMode" value="employer"><span>My employer's rate</span></label>
    </div>
    <div class="emp" id="empWrap" hidden>
      <input type="number" id="empCents" min="0" max="500" step="0.1" inputmode="decimal" placeholder="65" aria-describedby="empHelp">
      <label for="empCents" id="empHelp">cents per business mile (medical, moving and charity trips keep the IRS rate)</label>
    </div>
    <div id="tripRows">
      <% exampleTrips.forEach(function (t, i) { %>
      <div class="trip-row" data-i="<%= i %>">
        <div><span class="lbl">Date</span><input type="date" name="date" aria-label="Date" value="<%= t.date %>"></div>
        <div><span class="lbl">Miles</span><input type="number" name="miles" aria-label="Miles" min="0" step="0.1" inputmode="decimal" value="<%= t.miles %>"></div>
        <div><span class="lbl">Type</span><select name="type" aria-label="Type"><% Reimburse.TYPES.forEach(function (k) { %><option value="<%= k %>"<%= k === t.type ? ' selected' : '' %>><%= Reimburse.LABELS[k] %></option><% }) %></select></div>
        <div class="f-dest"><span class="lbl">Destination</span><input type="text" name="dest" aria-label="Destination" maxlength="120" value="<%= t.dest %>"></div>
        <div class="f-purpose"><span class="lbl">Business purpose</span><input type="text" name="purpose" aria-label="Business purpose" maxlength="200" value="<%= t.purpose %>"></div>
        <button type="button" class="del" aria-label="Remove trip">&times;<span> Remove</span></button>
      </div>
      <% }) %>
    </div>
    <div class="trip-actions">
